# Copy to .env and fill in. Never commit the real .env.
# Full explanations of each variable are in OPERATIONS.md section 1.

# ─── Required: the server will not start without these ───────────────────────
DATABASE_URL="mysql://user:password@127.0.0.1:3306/civictree"

# At least 32 characters each, and they must differ from each other.
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Set these BEFORE go-live ────────────────────────────────────────────────
# Each falls back to a key derived from a JWT secret when unset, which works but
# ties them together: rotating one JWT secret then breaks unrelated data.
#
# SECRET_ENC_KEY in particular must be decided before any real voucher PIN is
# saved. Setting it later cannot read PINs that were encrypted with the
# derived key — that needs a re-encryption pass (scripts/encrypt_voucher_pins.js).
#
# Exactly 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENC_KEY=
OTP_SECRET=
RECOVERY_CODE_SECRET=
USSD_STATE_SECRET=

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development          # "production" on the server
PORT=5000

# Public URL of this API, and of the web app. Used to build callback and
# redirect URLs, and to decide which browser origins may call the API.
API_URL=https://api.example.com
FRONTEND_URL=https://example.com

# Extra browser origins allowed to call the API, comma-separated
CORS_ORIGINS=

# Number of reverse proxies in front of the app. Set to 0 when reached directly.
# Rate limiting and the Hubtel IP allow-list both depend on getting the real
# client IP, so this must match the actual deployment.
TRUST_PROXY=1

# ─── Hubtel: payments and payouts ────────────────────────────────────────────
HUBTEL_PAYMENT_API_ID=
HUBTEL_PAYMENT_API_KEY=
HUBTEL_PAYMENT_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_PAYMENT_DISBURSEMENT_ACCOUNT_NUMBER=

# Shared secret appended to callback URLs
HUBTEL_CALLBACK_TOKEN=

# Comma-separated addresses Hubtel calls back from. Required in production:
# without it the allow-list has nothing to match and callbacks are refused.
HUBTEL_CALLBACK_IPS=

# Only ever "off" for local development. Leaving it off in production means any
# address on the internet can post a fake "payment received" callback.
HUBTEL_IP_CHECK=on

HUBTEL_RETURN_URL=
HUBTEL_CANCEL_URL=

# ─── Hubtel: SMS (voucher delivery and password reset codes) ─────────────────
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=

# ─── Cloudinary: timetable file uploads ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Web push (npm run generate-vapid) ───────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# ENABLE_API_DOCS=false       # keep the Swagger UI off in production
# LOG_LEVEL=info
# MAX_VOUCHERS_PER_ORDER=
# PAYOUT_ALERT_THRESHOLD_GHS= # payout spike alert threshold
# ACCESS_TOKEN_TTL=

# Privileged user for restore drills; falls back to DATABASE_URL
# VERIFY_DATABASE_URL=

# Throwaway database for the security suite. Must be local and contain "test"
# in its name — the suite wipes it.
# TEST_DATABASE_URL="mysql://root:password@127.0.0.1:3306/civictree_test"

# ─── Not currently in use ────────────────────────────────────────────────────
# Email delivery is off: password resets go by SMS only. Setting these does not
# switch it on by itself.
# EMAIL_USER=
# EMAIL_PASSWORD=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Seed accounts, read once by prisma/seed.js and prisma/seedPartner.js
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# PARTNER_EMAIL=
# PARTNER_PASSWORD=
